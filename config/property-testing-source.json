    "decisions": [
      {
        "source": "LICENSE",
        "decision": "retained",
        "reason": "Retain the complete CC-BY-SA-4.0 license with the local adaptation and attribute Trail of Bits, Henrik Brodin and contributors; no endorsement is implied."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/SKILL.md",
        "decision": "adapted",
        "reason": "Preserve scoped property selection and mode routing. Remove effort pinning, qualify roundtrip strength, retain project authorization and dependencies, and make host-owned test-session cleanup explicit."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/references/generating.md",
        "decision": "adapted",
        "reason": "Retain constrained generators, explicit examples, shrinking and documented error outcomes. Use project-specific bounded budgets and explicit timeouts rather than universal Hypothesis settings."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/references/interpreting-failures.md",
        "decision": "adapted",
        "reason": "Retain classification of wrong property, ambiguous specification and implementation defects. Add harness/environment failure as incomplete evidence and preserve replay inputs until their consumers finish."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/references/libraries.md",
        "decision": "adapted",
        "reason": "Use a compact set of official library pointers and the consuming project's pinned choice; do not impose defaults, add a second library, or authorize live contract infrastructure."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/references/refactoring.md",
        "decision": "adapted",
        "reason": "Retain minimal seams within effective task authority. Correct the claim that mutation prevents before/after tests, and avoid new inverse parsers or public APIs solely to manufacture a roundtrip."
      },
      {
        "source": "plugins/property-based-testing/skills/property-based-testing/references/reviewing.md",
        "decision": "adapted",
        "reason": "Retain vacuity, tautology, independence and input-domain review. Classify severity by current impact rather than automatic CRITICAL/HIGH labels; respect read-only source boundaries."
      }
    ]
  }
