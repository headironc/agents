    "decisions": [
      {
        "source": "LICENSE",
        "decision": "retained",
        "reason": "Retain the complete CC-BY-SA-4.0 license and attribute Trail of Bits and contributors without implying endorsement."
      },
      {
        "source": "plugins/rust-review/prompts/general/cancel-safety-finder.md",
        "decision": "adapted",
        "reason": "Retain cancellation ownership and partial-side-effect analysis; reject detached tasks as a universal repair and require actual cancellation and retry contracts."
      },
      {
        "source": "plugins/rust-review/prompts/general/send-sync-bounds-finder.md",
        "decision": "adapted",
        "reason": "Distinguish compiler-enforced Send and lifetime errors from a demonstrated unsafe escape; preserve legitimate local tasks and actual runtime API constraints."
      },
      {
        "source": "plugins/rust-review/prompts/general/unsafe-sync-impl-finder.md",
        "decision": "adapted",
        "reason": "Review each manual auto-trait invariant across safe constructors, generic bounds and foreign-resource destruction; synchronization must protect all actual access and respect thread affinity."
      },
      {
        "source": "plugins/rust-review/prompts/general/panic-unwind-unsafe-finder.md",
        "decision": "adapted",
        "reason": "Retain initialized-range and destructor tracing with reachable panic evidence; separate abort availability impact from unwind memory corruption and require exception-safe guards."
      },
      {
        "source": "plugins/rust-review/prompts/general/closure-ffi-finder.md",
        "decision": "adapted",
        "reason": "Retain callback lifetime, in-flight invocation and foreign ownership checks; remove unverified universal version claims and require proof before catch_unwind or AssertUnwindSafe remedies."
      },
      {
        "source": "plugins/rust-review/prompts/general/resource-exhaustion-finder.md",
        "decision": "adapted",
        "reason": "Trace attacker-controlled total cost, buffering and concurrency; verify upstream caps and effective cancellation rather than treating every allocation as a vulnerability."
      },
      {
        "source": "plugins/rust-review/prompts/general/toctou-finder.md",
        "decision": "adapted",
        "reason": "Require attacker control and a security-relevant check/use race; distinguish validated handles and exclusive creation from protection of mutable ancestors."
      }
    ]
  }
