    "decisions": [
      {
        "source": "LICENSE",
        "decision": "retained",
        "reason": "Retain the complete Apache-2.0 license from google/skills byte-identically as LICENSE.txt under the google-cloud package root."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/rules/google-cloud-discovery.md",
        "decision": "adapted",
        "reason": "Move catalog routing and non-inference guardrails from an always-on global rule into the google-cloud top-level SKILL.md router to preserve global AGENTS.md byte budgets."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/gcloud/SKILL.md",
        "decision": "adapted",
        "reason": "Establish Contract subject gcloud with leaf-level gcloud help validation, data reduction, dry-run preview, explicit scoping, and denylist consent while dropping rigid English templates and default telemetry attribution."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/gcloud/references/cli-usage.md",
        "decision": "adapted",
        "reason": "Adapt CLI setup, ADC, service account impersonation, and WIF guidance with command -v gcloud, explicit installation consent, and client-neutral phrasing."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/gcloud/references/mcp-usage.md",
        "decision": "adapted",
        "reason": "Document both local @google-cloud/gcloud-mcp with prefix denylist and @google-cloud/observability-mcp fragments plus hosted cloudcli.googleapis.com/mcp without mutating personal client configs."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/google-cloud-recipe-auth/SKILL.md",
        "decision": "adapted",
        "reason": "Adapt IAM, ADC, impersonation, WIF, OIDC, and restricted API key practices as google-cloud-auth nested child skill with gcloud contract routing and header-only API key rules."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/google-cloud-recipe-onboarding/SKILL.md",
        "decision": "adapted",
        "reason": "Adapt standalone developer onboarding, enterprise org guardrail, project reuse, and billing confirmation gates as google-cloud-onboarding while dropping rigid verbatim dialogue templates and silent config writes."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/finding-google-skills/SKILL.md",
        "decision": "adapted",
        "reason": "Narrow trigger to explicit discovery or confirmed Google Cloud gaps; route curl, jq, and task-temp contracts and enforce untrusted external input boundaries without polluting target working trees."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/retrieving-developer-knowledge/SKILL.md",
        "decision": "adapted",
        "reason": "Prefer Developer Knowledge MCP with 429 fallback and route curl and gcloud for REST fallback while forbidding ?key= URL query strings in favor of X-Goog-Api-Key headers."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/retrieving-developer-knowledge/references/mcp-usage.md",
        "decision": "adapted",
        "reason": "Preserve search_documents, answer_query, and get_documents usage and point unmounted clients to zero-secret capability fragments instead of editing personal configs."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/retrieving-developer-knowledge/references/api-fallback.md",
        "decision": "adapted",
        "reason": "Retain v1 REST endpoint forms with OAuth Bearer precedence and rewrite API key examples to pass X-Goog-Api-Key via HTTP headers instead of URL query parameters."
      },
      {
        "source": "plugins/cloud/google-cloud-developer/skills/retrieving-developer-knowledge/references/supported-domains.md",
        "decision": "adopted",
        "reason": "Adopt the official list of Developer Knowledge indexed public developer domains under concise formatting without mandatory attribution tags."
      },
      {
        "source": "skills/cloud/google-cloud-storage-basics/SKILL.md",
        "decision": "adapted",
        "reason": "Adapt GCS bucket/object guidance as google-cloud-storage nested child skill routing gcloud contract, snake_case projections, safe-mode MCP confirmation bounds, and on-demand heavy plugin discovery while omitting default telemetry tags."
      },
      {
        "source": "skills/cloud/google-cloud-storage-basics/references/mcp-usage.md",
        "decision": "adapted",
        "reason": "Fold GCS MCP server mode boundaries (companion @google-cloud/storage-mcp safe mode without --enable-destructive-tools, remote 8 MiB/Model Armor, and Toolbox CLOUD_STORAGE_PROJECT) into google-cloud-storage without mutating client configs."
      },
      {
        "source": "skills/cloud/cloud-sql-basics/SKILL.md",
        "decision": "adapted",
        "reason": "Adapt Cloud SQL basics as PostgreSQL-focused cloud-sql-postgresql nested child skill enforcing gcloud contract routing, Auth Proxy/IAM auth, explicit mutation confirmations, and strict exclusion of real private hosts or credentials."
      },
      {
        "source": "skills/cloud/cloud-sql-basics/references/mcp-usage.md",
        "decision": "adapted",
        "reason": "Fold Cloud SQL MCP readonly vs mutating tool boundaries (execute_sql_readonly vs DDL/DML/backup/lifecycle mutations) into cloud-sql-postgresql without bundling private database configs or external data-cloud submodules."
      }
    ]
  }
