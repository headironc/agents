  "assessment": {
    "revision": "9585e288d21d2da994a0550c926a09b62d79f8bd",
    "policySha256": "afde2b9de73d5fd2c03105bfd7731ba9cabd9dfb58e4fd20341f40172c1d90ee",
    "decisions": [
      {
        "source": "LICENSE.md",
        "decision": "retained",
        "reason": "Preserve the complete MIT license and copyright with maintenance originals; no upstream agent entrypoint or wholesale policy text is installed."
      },
      {
        "source": "src/guidelines/correctness/M-UNSAFE.md",
        "decision": "adopted",
        "reason": "Require a justified small unsafe boundary, operation-specific safety arguments and adversarial validation. Use Miri where supported without claiming that it proves soundness or silently waiving missing coverage."
      },
      {
        "source": "src/guidelines/correctness/M-UNSOUND.md",
        "decision": "adopted",
        "reason": "Safe APIs must uphold memory safety for all permitted safe calls, including panic and reentrancy. Preserve private invariant boundaries; an unenforceable caller safety precondition requires an unsafe API."
      },
      {
        "source": "src/guidelines/ffi/M-FFI-TRANSLATES.md",
        "decision": "adopted",
        "reason": "Separate FFI representation and ownership translation from business logic, with explicit errors and unwind contracts. Do not require a new crate for every adapter; project delivery ownership remains authoritative."
      },
      {
        "source": "src/guidelines/libs/building/M-FEATURES-ADDITIVE.md",
        "decision": "adopted",
        "reason": "Public library features should compose additively with declared feature dependencies. Retain project-owned toolchains, platform/backend restrictions and supported-combination checks instead of a universal all-features command."
      },
      {
        "source": "src/guidelines/performance/M-HOTPATH.md",
        "decision": "adopted",
        "reason": "Require representative optimized-build baselines and equivalent measurements for performance changes. Do not import specific benchmark packages, allocator choices, anecdotal speedups or mandatory profiling for unrelated tasks."
      },
      {
        "source": "src/guidelines/performance/M-YIELD-POINTS.md",
        "decision": "adopted",
        "reason": "Prevent executor starvation through supported compute/blocking facilities or bounded cooperative work. Do not assume every await yields or import a universal microsecond interval; ready futures can continue without yielding."
      }
    ]
  }
}
